# === Server ===
PORT=3000
HOST=127.0.0.1

# === Python Worker ===
PYTHON_PATH=python
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FRAME_SKIP=3
MAX_PROCESSING_QUEUE=5

# === Recognition ===
CONFIDENCE_THRESHOLD=0.45
UNKNOWN_LABEL=UNKNOWN
RECOGNITION_COOLDOWN_SEC=5
KNOWN_FACES_DIR=./known_faces

# === Worker Lifecycle ===
MAX_WORKER_RESTARTS=5
RESTART_WINDOW_SEC=60

# === WebSocket ===
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_EVENT_RATE=10

# === Database ===
DB_PATH=./data/recognition.db
